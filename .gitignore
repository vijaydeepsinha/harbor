# Large media (hosted on GitHub Releases)
*.mp4

# Build output
dist/

# Code Mode execution store (EXECUTION_STORE_TYPE=file)
var/

# Node
node_modules/
.next/
out/

# Env
.env
.env.local
.env.*.local

# Logs and local tool artifacts
*.log
pre-log.json
post-log.json
bench/*.log

# IDE
.idea/
.vscode/
*.swp

# Claude Code local settings
.claude/

# OS
**/.DS_Store

# Test / coverage
.pytest_cache/
coverage/

# Internal working files — not for public repo
.internal/
reviews/
__pycache__/
pr_reviews/

# Postman: local exports are ignored; the committed collections + environment are not
postman/*
!postman/README.md
!postman/Harbor.postman_collection.json
!postman/mcp-governance.postman_collection.json
!postman/environments/
postman/environments/*
!postman/environments/local.postman_environment.json

# Governance E2E run output (JUnit, JSON, container logs, failure dumps, store bind mount)
artifacts/
